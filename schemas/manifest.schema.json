{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ciap.local/schemas/manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestId", "repository", "branch", "operationMode", "registry", "canonical"],
  "properties": {
    "manifestId": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "minLength": 1},
    "commit": {"type": ["string", "null"]},
    "operationMode": {"enum": ["BOOTSTRAP", "STEADY_STATE"]},
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usable"],
      "properties": {
        "usable": {"type": "boolean"},
        "location": {"type": ["string", "null"]},
        "versionOrHash": {"type": ["string", "null"]}
      }
    },
    "canonical": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "hash"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
        }
      }
    }
  }
}
